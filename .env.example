# ╔══════════════════════════════════════════════════════════════════════════════════╗
# ║                           VOXCORE — .env.example                                ║
# ║                    COPY TO .env AND FILL IN YOUR API KEYS                       ║
# ╚══════════════════════════════════════════════════════════════════════════════════╝
#
# Usage: cp .env.example .env && nano .env
# Loaded by: python-dotenv in main.py → load_dotenv()
# ═══════════════════════════════════════════════════════════════════════════════════

# Groq API Key — Required — Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# HuggingFace API Key — Optional — Only needed if using HF faster-whisper fallback
HF_API_KEY=hf_your_huggingface_api_key_here

# V2: HuggingFace Audio Backend — Required for Speaking Monitor (Gate 3)
# Self-hosted whisper endpoint with /transcribe/monitor route
HF_AUDIO_API_KEY=your_hf_audio_api_key_here
HF_AUDIO_BASE_URL=https://your-hf-audio-backend.hf.space

# Log level override (optional — can also set via CLI --log-level)
LOG_LEVEL=INFO
